<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:GestorTI.Converters"
             xmlns:vm="using:GestorTI.ViewModels"
             xmlns:views="using:GestorTI.Views"
             x:Class="GestorTI.App"
             RequestedThemeVariant="Default">

  <!-- ViewModel -> View: a área principal do MainWindow só precisa de um ContentControl. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView/></DataTemplate>
    <DataTemplate DataType="vm:ClientesViewModel"><views:ClientesView/></DataTemplate>
    <DataTemplate DataType="vm:ContratosViewModel"><views:ContratosView/></DataTemplate>
    <DataTemplate DataType="vm:ServicosViewModel"><views:ServicosView/></DataTemplate>
    <DataTemplate DataType="vm:OrcamentosViewModel"><views:OrcamentosView/></DataTemplate>
    <DataTemplate DataType="vm:FinanceiroViewModel"><views:FinanceiroView/></DataTemplate>
    <DataTemplate DataType="vm:NotasFiscaisViewModel"><views:NotasFiscaisView/></DataTemplate>
    <DataTemplate DataType="vm:ConfiguracoesViewModel"><views:ConfiguracoesView/></DataTemplate>
    <DataTemplate DataType="vm:ContaViewModel"><views:ContaView/></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SidebarBrush" Color="#0B1F4B"/>
          <SolidColorBrush x:Key="PrimaryBrush" Color="#0030B9"/>
          <SolidColorBrush x:Key="PageBrush" Color="#F5F6FA"/>
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="TextBrush" Color="#101828"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
          <SolidColorBrush x:Key="BorderBrushSoft" Color="#E4E7EC"/>
          <SolidColorBrush x:Key="GhostFgBrush" Color="#0030B9"/>
          <SolidColorBrush x:Key="GhostHoverBrush" Color="#E5ECFF"/>
          <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF4DB"/>
          <SolidColorBrush x:Key="WarnBorderBrush" Color="#F5D58A"/>
          <SolidColorBrush x:Key="WarnFgBrush" Color="#7A4B00"/>
          <SolidColorBrush x:Key="DangerBgBrush" Color="#FDE7E7"/>
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#F4B7B2"/>
          <SolidColorBrush x:Key="DangerFgBrush" Color="#7A1A12"/>
          <SolidColorBrush x:Key="DangerTextBrush" Color="#B42318"/>
          <SolidColorBrush x:Key="InfoBgBrush" Color="#E5ECFF"/>
          <SolidColorBrush x:Key="InfoBorderBrush" Color="#B9CBFF"/>
          <SolidColorBrush x:Key="InfoFgBrush" Color="#0B1F4B"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SidebarBrush" Color="#070F26"/>
          <SolidColorBrush x:Key="PrimaryBrush" Color="#2F5BFF"/>
          <SolidColorBrush x:Key="PageBrush" Color="#0E1424"/>
          <SolidColorBrush x:Key="CardBrush" Color="#171F33"/>
          <SolidColorBrush x:Key="TextBrush" Color="#EEF1F8"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#9AA6C0"/>
          <SolidColorBrush x:Key="BorderBrushSoft" Color="#2A3552"/>
          <SolidColorBrush x:Key="GhostFgBrush" Color="#8FB0FF"/>
          <SolidColorBrush x:Key="GhostHoverBrush" Color="#22305A"/>
          <SolidColorBrush x:Key="WarnBgBrush" Color="#3A2E0F"/>
          <SolidColorBrush x:Key="WarnBorderBrush" Color="#6B5417"/>
          <SolidColorBrush x:Key="WarnFgBrush" Color="#FFD98A"/>
          <SolidColorBrush x:Key="DangerBgBrush" Color="#3D1A1A"/>
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#7A2E2E"/>
          <SolidColorBrush x:Key="DangerFgBrush" Color="#FFB4AD"/>
          <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8A80"/>
          <SolidColorBrush x:Key="InfoBgBrush" Color="#1B2A55"/>
          <SolidColorBrush x:Key="InfoBorderBrush" Color="#2F4590"/>
          <SolidColorBrush x:Key="InfoFgBrush" Color="#C9D8FF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <conv:StatusBrushConverter x:Key="StatusBrush"/>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <!-- Tipografia -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="TextBlock.kpi"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBlock.cell"><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="TextBlock.th"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>

    <!-- Cartão -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>
    <Style Selector="Border.badge"><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="10,3"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

    <!-- Campos -->
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>

    <!-- Botões -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0027A0"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource GhostFgBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource GhostFgBrush}"/>
    </Style>

    <!-- Tela de login -->
    <Style Selector="TextBox.login"><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.login"><Setter Property="MinHeight" Value="46"/><Setter Property="FontSize" Value="15"/></Style>

    <!-- Menu lateral -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C7D2F0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#16306E"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#0030B9"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0030B9"/><Setter Property="Foreground" Value="White"/>
    </Style>
  </Application.Styles>
</Application>
