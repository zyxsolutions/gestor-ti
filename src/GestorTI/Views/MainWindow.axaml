<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GestorTI.Views"
        x:Class="GestorTI.Views.MainWindow"
        Title="ZYX Core"
        Icon="/Assets/app.ico"
        Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}">

  <Grid>
  <Grid ColumnDefinitions="248,*" IsVisible="{Binding Autenticado}">

    <!-- ===== Menu lateral ===== -->
    <Border Background="{DynamicResource SidebarBrush}" Padding="16">
      <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,6,0,28">
          <Image Source="/Assets/logo-mark.png" Width="44" Height="44" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="ZYX Core" FontSize="20" FontWeight="ExtraBold" Foreground="White"/>
            <TextBlock Text="Gestão de operações de TI" FontSize="11" Foreground="#8FA3D6"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
          <!-- Usuário logado -->
          <Border Background="#12306E" CornerRadius="10" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="34" Height="34" CornerRadius="17" Background="#0030B9">
                <TextBlock Text="{Binding Iniciais}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding UsuarioNome}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                <TextBlock Text="{Binding PerfilTexto}" Foreground="#8FA3D6" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Button Classes="nav" Classes.active="{Binding IsConta}"
                  Command="{Binding NavegarCommand}" CommandParameter="Conta" Content="Minha conta"/>
          <Button Classes="nav" Classes.active="{Binding IsConfiguracoes}" IsVisible="{Binding EhAdmin}"
                  Command="{Binding NavegarCommand}" CommandParameter="Configuracoes" Content="Configurações"/>
          <Button Classes="nav" Command="{Binding AlternarTemaCommand}" Content="Modo claro / escuro"/>
          <Button Classes="nav" Command="{Binding SairCommand}" Content="Sair"/>
          <Button Classes="primary" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="#12B76A" Content="{Binding TextoAtualizacao}"
                  IsVisible="{Binding AtualizacaoDisponivel}" IsEnabled="{Binding !Atualizando}"
                  Command="{Binding AtualizarAppCommand}"/>
          <TextBlock Text="{Binding VersaoTexto}" FontSize="11" Foreground="#8FA3D6" Margin="14,10,0,0"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <Button Classes="nav" Classes.active="{Binding IsDashboard}"
                  Command="{Binding NavegarCommand}" CommandParameter="Dashboard" Content="Início"/>
          <Button Classes="nav" Classes.active="{Binding IsClientes}"
                  Command="{Binding NavegarCommand}" CommandParameter="Clientes" Content="Clientes"/>
          <Button Classes="nav" Classes.active="{Binding IsContratos}"
                  Command="{Binding NavegarCommand}" CommandParameter="Contratos" Content="Assinaturas (Contratos)"/>
          <Button Classes="nav" Classes.active="{Binding IsFinanceiro}"
                  Command="{Binding NavegarCommand}" CommandParameter="Financeiro" Content="Cobranças e Extrato"/>
          <Button Classes="nav" Classes.active="{Binding IsNotasFiscais}"
                  Command="{Binding NavegarCommand}" CommandParameter="NotasFiscais" Content="Notas Fiscais"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Área principal ===== -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top"
              IsVisible="{Binding PaginaAtual.TemMensagem, FallbackValue=False}"
              Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="0,0,0,1" Padding="32,12">
        <TextBlock Text="{Binding PaginaAtual.Mensagem}" Foreground="{DynamicResource WarnFgBrush}" TextWrapping="Wrap"/>
      </Border>
      <ScrollViewer>
        <ContentControl Content="{Binding PaginaAtual}" Margin="32"/>
      </ScrollViewer>
    </DockPanel>
  </Grid>

  <!-- Tela de login por cima de tudo até alguém entrar -->
  <Border IsVisible="{Binding NaoAutenticado}" Background="{DynamicResource CardBrush}">
    <Grid>
      <views:LoginView DataContext="{Binding Login}"/>
      <Button Classes="primary" Background="#12B76A" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="72,0,0,72" Padding="18,11" Content="{Binding TextoAtualizacao}"
              IsVisible="{Binding AtualizacaoDisponivel}" IsEnabled="{Binding !Atualizando}"
              Command="{Binding AtualizarAppCommand}"/>
    </Grid>
  </Border>
  </Grid>
</Window>
